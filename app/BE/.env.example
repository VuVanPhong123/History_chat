[file name]: .env.example
[file content begin]
# CẤU HÌNH MÔI TRƯỜNG - LỊCH SỬ CHAT & QUIZ SERVER

# ============ CẤU HÌNH CƠ BẢN ============
ENVIRONMENT=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ============ DATABASE ============
DATABASE_URL=sqlite:///./data/history.db

# ============ BẢO MẬT ============
# Lệnh để tạo secret key: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=5
ADMIN_PASSWORD=your-strong-admin-password-here

# ============ DỮ LIỆU RAG ============
RAG_JSONL_PATH=./data/rag.jsonl

# ============ NGROK (TÙY CHỌN) ============
NGROK_AUTH_TOKEN=your-ngrok-token-optional

# ============ FRONTEND ============
FRONTEND_URL=http://localhost:3000

# ============ WORKER URLs ============
# Chat worker URLs (phân cách bằng dấu phẩy, KHÔNG có dấu ngoặc)
# Ví dụ: https://chat-worker-1.ngrok.io,https://chat-worker-2.ngrok.io
CHAT_WORKER_URLS_STR=

# Quiz worker URLs (phân cách bằng dấu phẩy, KHÔNG có dấu ngoặc)
# Ví dụ: https://quiz-worker-1.ngrok.io,https://quiz-worker-2.ngrok.io
QUIZ_WORKER_URLS_STR=
[file content end]